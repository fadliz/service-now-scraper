# Defaults to .\tracker-paste.txt in the project root.
TRACKER_TXT=tracker-paste.txt
TRAINING_CSV=~\dataset_incident.csv
SNOW_URL=https://your-instance.service-now.com/incident.do?sys_id=-1
DEFAULT_CALLER=operational user1
# Optional: page containing the Input New Incident link. If omitted, SNOW_URL is used directly.
DASHBOARD_URL=

# Never commit real credentials. Prefer session-only environment variables:
#   $env:SNOW_USERNAME='...'
#   $env:SNOW_PASSWORD='...'
SNOW_USERNAME=
SNOW_PASSWORD=

# Browser options
BROWSER_MODE=brave
BRAVE_EXECUTABLE=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
CDP_URL=http://127.0.0.1:9222
